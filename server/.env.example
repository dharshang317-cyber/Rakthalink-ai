# ========================================================
# RAKTHALINK AI - BACKEND ENVIRONMENT VARIABLES TEMPLATE
# ========================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Client Frontend URL (For CORS Security)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas URI or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/rakthalink

# JWT Secret for User Session Tokens (Generate a secure random string)
JWT_SECRET=rakthalink_super_secret_jwt_key_development_change_in_production_2026
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Client Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# AI / LLM API Key (Google Gemini API / OpenAI / OpenRouter - Server-Side Only)
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash
